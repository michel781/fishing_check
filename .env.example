# 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 기상청 단기예보 + 국립해양조사원 조석예보를 이 키 하나로 호출합니다.
# 없으면 Open-Meteo → 천문 추정 모델 순으로 폴백합니다.
DATA_GO_KR_SERVICE_KEY=
# (선택) 조석예보에 다른 키를 쓸 때만 지정. 비우면 위 키를 사용
KHOA_SERVICE_KEY=
# (선택) 조석예보 API 주소가 바뀌었을 때 덮어쓰기
KHOA_TIDE_URL=
# (선택) 실측·예측 조위 API 주소 덮어쓰기 (조석예보 대체 경로)
KHOA_TIDE_SERIES_URL=
# 외부 API를 전혀 호출하지 않고 데모 데이터만 사용 (오프라인 개발용)
FISHING_OFFLINE=
