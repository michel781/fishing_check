# 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 기상청 단기예보 + 국립해양조사원 조석예보를 이 키 하나로 호출합니다.
# 없으면 Open-Meteo → 천문 추정 모델 순으로 폴백합니다.
DATA_GO_KR_SERVICE_KEY=
# (선택) 조석예보에 다른 키를 쓸 때만 지정. 비우면 위 키를 사용
KHOA_SERVICE_KEY=
# (선택) 조석예보 API 주소가 바뀌었을 때 덮어쓰기
KHOA_TIDE_URL=
# (선택) 실측·예측 조위 API 주소 덮어쓰기 (조석예보 대체 경로)
KHOA_TIDE_SERIES_URL=
# 외부 API를 전혀 호출하지 않고 데모 데이터만 사용 (오프라인 개발용)
FISHING_OFFLINE=

# ───────── 회원가입·로그인 (Supabase) — 없으면 로그인 없이 이 기기에만 저장 ─────────
# Supabase > Project Settings > API 에서 복사. NEXT_PUBLIC_ 값은 빌드 때 들어가므로 넣은 뒤 다시 배포하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 회원 탈퇴 처리용 서버 전용 키 (service_role 또는 sb_secret_...). 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase 에서 Kakao 로그인을 켰다면 1
NEXT_PUBLIC_AUTH_KAKAO=
# 약관·개인정보 처리방침에 표시할 운영자 이름과 문의 메일
OPERATOR_NAME=
CONTACT_EMAIL=

# ───────── 채비 실시간 가격 ─────────
# 쿠팡 파트너스 Open API (파트너스 > 추가기능 > Open API 에서 발급, 최종 승인 필요)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# (선택) 클릭 추적용 subId
COUPANG_SUB_ID=
# (선택) 쿠팡 승인 전 대체: 네이버 개발자센터 > 검색 API (쇼핑)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) 내 주변 주소 표시를 카카오 지도로 (없으면 OpenStreetMap 무료 사용)
KAKAO_REST_API_KEY=
